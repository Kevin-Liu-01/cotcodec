# syntax=docker/dockerfile:1.7
# Discovery-only source overlay for an already sealed local research image.
# The caller must verify BASE_IMAGE resolves to BASE_IMAGE_ID before building.
ARG BASE_IMAGE=cotcodec-research:8c51687b-architecture
FROM ${BASE_IMAGE}

ARG GIT_SHA=unknown
ARG GIT_TREE=unknown
ARG SOURCE_TREE_SHA256=unknown
ARG BASE_IMAGE_ID=unknown
ARG UV_EXTRA=architecture
ARG INCLUDE_DEV=false

LABEL org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.cotcodec-git-sha="${GIT_SHA}" \
      org.opencontainers.image.cotcodec-git-tree="${GIT_TREE}" \
      org.opencontainers.image.source-tree-sha256="${SOURCE_TREE_SHA256}" \
      org.opencontainers.image.cotcodec-runtime-profile="${UV_EXTRA}-source-overlay" \
      org.opencontainers.image.cotcodec-base-image-id="${BASE_IMAGE_ID}" \
      org.opencontainers.image.cotcodec-dev-dependencies="${INCLUDE_DEV}" \
      org.opencontainers.image.source="https://github.com/Kevin-Liu-01/cotcodec"

RUN test -d /workspace/cotcodec/.venv \
    && find /workspace/cotcodec -mindepth 1 -maxdepth 1 \
       ! -name .venv -exec rm -rf -- {} +
WORKDIR /workspace/cotcodec
COPY . /workspace/cotcodec

RUN if [ "${INCLUDE_DEV}" = "true" ]; then dev_flag="--dev"; else dev_flag="--no-dev"; fi \
    && if [ "${UV_EXTRA}" = "none" ]; then \
        uv sync --frozen "${dev_flag}"; \
    else \
        uv sync --frozen "${dev_flag}" --extra "${UV_EXTRA}"; \
    fi \
    && python scripts/check_harness_env.py \
    && GIT_SHA_VALUE="${GIT_SHA}" SOURCE_SHA_VALUE="${SOURCE_TREE_SHA256}" \
       python infra/research/write_provenance.py /etc/cotcodec-provenance.json
