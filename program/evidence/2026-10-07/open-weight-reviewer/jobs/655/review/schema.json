{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open-weight reviewer smoke answer",
  "type": "object",
  "additionalProperties": false,
  "required": ["falsifiability_score", "has_falsifier", "largest_defect"],
  "properties": {
    "falsifiability_score": {"type": "integer", "minimum": 0, "maximum": 10},
    "has_falsifier": {"type": "boolean"},
    "largest_defect": {"type": "string", "minLength": 1, "maxLength": 400}
  }
}
