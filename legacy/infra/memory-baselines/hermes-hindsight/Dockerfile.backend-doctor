FROM ghcr.io/astral-sh/uv:python3.13-trixie-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends libgssapi-krb5-2 \
 && groupadd --gid 65532 hindsight \
 && useradd --uid 65532 --gid 65532 --home-dir /state --no-create-home \
      --shell /usr/sbin/nologin hindsight \
 && rm -rf /var/lib/apt/lists/*

COPY infra/memory-baselines/hindsight/pyproject.toml /opt/hindsight-project/pyproject.toml
COPY infra/memory-baselines/hindsight/uv.lock /opt/hindsight-project/uv.lock

RUN UV_PROJECT_ENVIRONMENT=/opt/hindsight-runtime \
    uv sync --frozen --project /opt/hindsight-project

COPY raw/baselines/hindsight/hindsight-api-slim /opt/hindsight-source/hindsight-api-slim
COPY raw/baselines/hindsight/hindsight-clients/python /opt/hindsight-source/hindsight-clients/python

RUN uv pip install \
      --python /opt/hindsight-runtime/bin/python \
      --no-deps \
      /opt/hindsight-source/hindsight-api-slim \
      /opt/hindsight-source/hindsight-clients/python \
 && /opt/hindsight-runtime/bin/python -c \
      "import importlib.metadata as m; assert m.version('hindsight-api-slim') == '0.9.0'; assert m.version('hindsight-client') == '0.9.0'; assert m.version('pg0-embedded') == '0.15.1'"

ENV HOME=/state \
    PATH=/opt/hindsight-runtime/bin:/usr/local/bin:/usr/bin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HINDSIGHT_API_HOST=0.0.0.0 \
    HINDSIGHT_API_PORT=8888 \
    HINDSIGHT_API_DATABASE_URL=postgresql://hindsight:hindsight@hindsight-postgres:5432/hindsight \
    HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai \
    HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=local-doctor \
    HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=cotcodec-deterministic-hash-v1 \
    HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=http://hindsight-model-stub:8080/v1 \
    HINDSIGHT_API_EMBEDDINGS_OPENAI_DIMENSIONS=16 \
    HINDSIGHT_API_RERANKER_PROVIDER=rrf \
    HINDSIGHT_API_LLM_PROVIDER=none \
    HINDSIGHT_API_WORKER_ID=cotcodec-hermes-hindsight-doctor \
    HINDSIGHT_API_LOG_LEVEL=warning \
    HINDSIGHT_API_ACCESS_LOG=false \
    LITELLM_LOCAL_MODEL_COST_MAP=True

USER 65532:65532
EXPOSE 8888
ENTRYPOINT ["/opt/hindsight-runtime/bin/hindsight-api", "--host", "0.0.0.0", "--port", "8888", "--log-level", "warning", "--no-access-log"]
